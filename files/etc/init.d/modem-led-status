#!/bin/sh /etc/rc.common
# Drive the blue LED from ModemManager state because qmi_wwan netdev
# statistics are not usable on this board.

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/modem-led-status
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
