#!/bin/sh /etc/rc.common
# Re-apply the FDD-only band policy after boot and after modem restarts.

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/modem-fdd-lock
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
