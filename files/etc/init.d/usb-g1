#!/bin/sh /etc/rc.common
# Use the adbd-created g1 gadget as the single USB gadget.
#
# g1 already contains both functions:
#   ffs.adb       -> ADB
#   rndis.rndis.1 -> RNDIS network
#
# adbd creates g1 at boot but may leave it unbound or bind it with Android
# VID/PID 18d1:d001.  With that VID/PID Windows binds the ADB driver to the
# whole device and never exposes the RNDIS interface.  This service gives the
# composite gadget generic Linux Foundation IDs and binds it once.

START=82
STOP=10

GADGET=/sys/kernel/config/usb_gadget/g1
FFS_MNT=/dev/usb-ffs/adb

log() {
	logger -t usb-g1 "$@"
}

start() {
	[ -d /sys/kernel/config/usb_gadget ] || return 1

	i=0
	while [ ! -d "$GADGET" ] && [ "$i" -lt 20 ]; do
		sleep 0.5
		i=$((i + 1))
	done
	[ -d "$GADGET" ] || {
		log "g1 not found, leaving adbd alone"
		return 0
	}

	mkdir -p "$FFS_MNT"
	grep -q " $FFS_MNT " /proc/mounts || \
		mount -t functionfs adb "$FFS_MNT" 2>/dev/null

	/etc/init.d/adbd start 2>/dev/null
	i=0
	while [ ! -e "$FFS_MNT/ep0" ] && [ "$i" -lt 20 ]; do
		sleep 0.5
		i=$((i + 1))
	done

	# Rebind so Windows sees the new VID/PID and the composite interfaces.
	if [ -s "$GADGET/UDC" ]; then
		echo "" > "$GADGET/UDC" 2>/dev/null
	fi
	echo 0x1d6b > "$GADGET/idVendor" 2>/dev/null
	echo 0x0104 > "$GADGET/idProduct" 2>/dev/null

	cfg="$(ls -d "$GADGET"/configs/* 2>/dev/null | head -n 1)"
	if [ -n "$cfg" ] && [ ! -e "$cfg/rndis.1" ] && \
	   [ -d "$GADGET/functions/rndis.rndis.1" ]; then
		ln -s "$GADGET/functions/rndis.rndis.1" "$cfg/rndis.1" 2>/dev/null
	fi

	udc="$(ls /sys/class/udc 2>/dev/null | head -n 1)"
	if [ -z "$udc" ]; then
		log "no UDC found"
		return 1
	fi
	if ! echo "$udc" > "$GADGET/UDC"; then
		log "failed to bind $udc"
		return 1
	fi

	sleep 1
	ifname="$(cat "$GADGET/functions/rndis.rndis.1/ifname" 2>/dev/null)"
	[ -n "$ifname" ] || ifname=usb0
	ip link set "$ifname" up 2>/dev/null
	ip link set "$ifname" master br-lan 2>/dev/null
	log "bound $udc ($ifname)"
}

stop() {
	[ -s "$GADGET/UDC" ] && echo "" > "$GADGET/UDC" 2>/dev/null
	return 0
}
