#!/bin/sh
# Keep SSH on all interfaces; binding to br-lan races usb0 on cold boot.
uci set dropbear.main=dropbear
uci set dropbear.main.enable='1'
uci set dropbear.main.PasswordAuth='on'
uci set dropbear.main.RootPasswordAuth='on'
uci -q delete dropbear.main.DirectInterface
uci -q delete dropbear.main._direct
uci commit dropbear
/etc/init.d/dropbear enable
/etc/init.d/dropbear start >/dev/null 2>&1
exit 0
