#!/bin/sh
# Blue LED = cellular state, not packet activity.
#
# On this modem the qmi_wwan netdev counters stay at zero even while data is
# flowing, so a netdev trigger can never light the blue LED.  Poll both
# ModemManager state and the real wwan0 interface/default route instead.

LED=/sys/class/leds/blue:wan

set_led() {
	[ "$(cat "$LED/brightness" 2>/dev/null)" = "$1" ] && return
	echo none > "$LED/trigger" 2>/dev/null || true
	echo "$1" > "$LED/brightness" 2>/dev/null || true
}

while true; do
	if [ ! -d "$LED" ]; then
		sleep 5
		continue
	fi

	id="$(mmcli -L 2>/dev/null | sed -n 's#.*Modem/\([0-9][0-9]*\).*#\1#p' | head -n1)"
	state=""
	if [ -n "$id" ]; then
		state="$(mmcli -m "$id" -K 2>/dev/null | sed -n 's/^modem.generic.state *: //p')"
	fi

	up=0
	flags="$(cat /sys/class/net/wwan0/flags 2>/dev/null || echo 0)"
	if [ $((flags & 1)) -ne 0 ] && ip route 2>/dev/null | grep -q '^default .* dev wwan0'; then
		up=1
	fi

	case "$state" in
		connected)
			[ "$up" = "1" ] && set_led 1 || set_led 0
			;;
		registered)
			# Registered is shown only after netifd has the real bearer.
			[ "$up" = "1" ] && set_led 1 || set_led 0
			;;
		*)
			set_led 0
			;;
	esac

	sleep 3
done
